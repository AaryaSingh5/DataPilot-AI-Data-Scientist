# DataPilot Environment Configuration Example

# Provider Selection: "mock" | "nvidia" | "anthropic"
DATAPILOT_PROVIDER=nvidia

# NVIDIA API Configuration (free dev tier at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-...

# Anthropic API Configuration (optional if using NVIDIA backend)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model Name Override
# NVIDIA options: meta/llama-3.2-11b-vision-instruct, meta/llama-3.2-90b-vision-instruct, deepseek-ai/deepseek-r1
# Anthropic options: claude-sonnet-5-5, claude-haiku-4-5-20251001
DATAPILOT_MODEL=meta/llama-3.2-11b-vision-instruct

# Engine Guardrails
DATAPILOT_MAX_LLM_CALLS=40

# Demo Password for Streamlit App (optional)
DEMO_PASSWORD=datapilot-secret-demo
